# ベースイメージ
FROM node:22-bookworm-slim

# docker CLI だけを公式イメージからコピー
# バックエンドからdockerコンテナを起動するために使う
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

# コンテナ内の作業ディレクトリ
WORKDIR /workspace

# 依存関係のファイルをdocker内にコピー
# COPY Copy元　Copy先の命令
# COPY package.jsonとpackage-lock.jsonを./(workspace)下にcopyなど
# jsonファイルをすべてコピー
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json

# npm の依存関係をインストール
# 先ほどpackageをコピーしたので依存関係に基づいてインストール
RUN npm ci

# ソースコードを全てコピー
# 最初からこれを使うとリビルドの際に毎回npm ciが呼ばれるため依存関係ファイルを先にコピーしている。
COPY . .

# 6. コンテナ起動時のデフォルトコマンド
CMD ["bash"]